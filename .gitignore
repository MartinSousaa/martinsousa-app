__pycache__/
*.pyc
*.pyo
.DS_Store

# Credencial nunca no repositorio. O Procfile e o _preparar_secrets
# montam este arquivo a partir do ambiente, em cada container.
.streamlit/secrets.toml

# Gerados em cada container, nunca no repositorio. O tv.html e o painel da TV
# escrito pelo worker (placar._write_tv_static); o beep.wav nasce ao lado dele;
# o tv-status.json e o estado do laco, que atravessa os dois processos.
static/tv.html
static/beep.wav
static/tv-status.json
static/tv-status.json.tmp
prompts_teste/
.checar_mutacao.trava
.checar_mutacao.socorro/

# EXPORTACOES PARA ANALISE EXTERNA — geradas sob demanda, nunca commitadas.
#
# `CODIGO_GERACAO_DE_IMAGEM.txt` e uma COPIA do codigo num instante. Commitada,
# ela envelhece e passa a discordar da fonte — e aí alguem analisa a versao
# velha achando que e a de hoje. Esta base ja pagou por isso: o
# `CONTEXTO_PARA_ANALISE.txt` ficou semanas commitado com um marcador de
# conflito dentro, e ninguem viu.
#
# Quando precisar de novo, gere de novo: a extracao le o codigo em producao e
# reprova se algum nome pedido nao existir mais.
CODIGO_GERACAO_DE_IMAGEM.txt
PROBLEMAS_GERACAO_DE_IMAGEM.txt
LINGUAGEM_GEMINI_vs_STUDIO.txt
COMO_ENVIAR_AO_CHATGPT.txt
CODIGO_AJUSTE_NO_CHAT.txt
PROBLEMA_AJUSTE_NO_CHAT.txt
.conferido.json
