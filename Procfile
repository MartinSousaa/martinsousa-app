web: mkdir -p .streamlit && { [ -n "$PLANILHA_ID" ] && printf 'PLANILHA_ID = "%s"\n' "$PLANILHA_ID"; printf '%s' "$STREAMLIT_SECRETS"; } > .streamlit/secrets.toml && python prestart.py && (while true; do python tv_worker.py; sleep 5; done &) && TV_WORKER=1 streamlit run app.py --server.port $PORT --server.address 0.0.0.0 --server.enableXsrfProtection false --server.enableCORS false --server.headless true
